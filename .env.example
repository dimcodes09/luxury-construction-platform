# implementationplan.md Phase 0 deliverable —
# ".env.example with EVERY REQUIRED VARIABLE DOCUMENTED."
#
# Copy to .env.local and fill in. Nothing here is committed with a real value.
# NFR-SEC-07: all secrets live in environment variables; no secret ever reaches
# the client bundle. Only NEXT_PUBLIC_* variables are exposed to the browser —
# if you are unsure whether something belongs there, it does not.

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="ZYVORA"

# ── MongoDB Atlas (SRS §2.2) ────────────────────────────────────────────────
# SRS flags this as [DECISION REQUIRED]: "MongoDB Atlas M0 (free) SLEEPS and has
# connection limits that will cause cold-start failures on a production lead
# form. Budget for M10 (~$57/mo) or accept M2/M5. Losing a lead to a database
# timeout is the most expensive possible failure." §11 rates it CRITICAL.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/zyvora?retryWrites=true&w=majority"

# ── Better Auth (admin only — there is no public login) ─────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Cloudinary (INT-04) ─────────────────────────────────────────────────────
# NFR-SEC-08: all media is served from Cloudinary, never from the app origin.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Resend (INT-05) ─────────────────────────────────────────────────────────
# Phase 4 risk: "Email deliverability is routinely discovered too late.
# CONFIGURE AND TEST SPF/DKIM/DMARC IN THIS PHASE, NOT AT LAUNCH."
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ZYVORA <hello@example.com>"

# ── Rate limiting (INT-12, NFR-SEC-05) ──────────────────────────────────────
# Optional. When absent, rate limiting falls back to MongoDB TTL counters
# rather than failing open — see src/lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# NFR-PRIV-06: "IP addresses stored HASHED, never in plaintext." This salt is
# what stops an unsalted hash being reversed by enumerating the IPv4 space.
# Generate with: openssl rand -base64 32
IP_HASH_SALT=""

# ── AI providers (§7.1 chain: Gemini → Cloudflare → Qwen → moodboard) ───────
# FR-AI-21: server-side only, never in the client bundle.
# §7.1: the Cloudflare MODEL ID must be a configuration value in admin, never a
# hard-coded constant — Cloudflare "retires older models WITHOUT NOTICE".
GEMINI_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_WORKERS_AI_TOKEN=""
# Optional paid escape hatch (Apache 2.0 licensed). Admin-enabled only.
QWEN_API_KEY=""

# ── Analytics (INT-07, INT-08) ──────────────────────────────────────────────
# NFR-PERF-09: loaded after idle or on interaction, never on the critical path.
# NFR-PRIV-02: gated on consent.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
NEXT_PUBLIC_GA4_ID=""

# ── Google Business Profile (INT-06) ────────────────────────────────────────
# FR-HOME-06: cached server-side for 6 hours with stale-while-revalidate.
# On failure we serve last-known values and NEVER show an error.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# ── Error tracking (NFR-OPS-03) ─────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Cron (SRS §6) ───────────────────────────────────────────────────────────
# Signed secret for /api/cron/* — TTL cleanup and the daily digest.
CRON_SECRET=""
